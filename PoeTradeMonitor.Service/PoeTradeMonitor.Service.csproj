<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net9.0-windows</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="AutoItX3.Assembly.dll" />
		<None Remove="Logs\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="InputSimulatorStandard" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
		<PackageReference Include="RateLimiter" />
		<PackageReference Include="Grpc.AspNetCore" />
		<PackageReference Include="Serilog.AspNetCore" />
		<PackageReference Include="SixLabors.ImageSharp" />
		<PackageReference Include="stateless" />
		<PackageReference Include="System.Text.Json" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PoeHudWrapper\PoeHudWrapper.csproj" />
		<ProjectReference Include="..\PoeLib\PoeLib.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="AutoItX3.Assembly">
			<HintPath>AutoItX3.Assembly.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<None Update="AutoItX3.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="AutoItX3_x64.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	
</Project>
